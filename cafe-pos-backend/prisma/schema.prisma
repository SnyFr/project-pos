generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Pilihan Nilai Tetap)
// ==========================================

enum Role {
  ADMIN
  CASHIER
  CUSTOMER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum OrderStatus {
  WAITING_PAYMENT
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

// ==========================================
// MODELS (Tabel Database)
// ==========================================

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  password     String   @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi: Satu user bisa berperan sebagai pembeli ATAU kasir di transaksi berbeda
  customerOrders Transaction[] @relation("CustomerTransactions")
  cashierOrders  Transaction[] @relation("CashierTransactions")

  @@map("users")
}

model CafeTable {
  id          Int         @id @default(autoincrement())
  tableNumber String      @unique @map("table_number") @db.VarChar(20)
  qrSlug      String      @unique @map("qr_slug") @db.VarChar(100)
  capacity    Int         @default(2)
  status      TableStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("cafe_tables")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(80)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  sku         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?  @map("image_url") @db.Text
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactionItems TransactionItem[]

  @@index([categoryId])
  @@map("products")
}

model Transaction {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(50)
  customerId      Int?          @map("customer_id")
  cashierId       Int?          @map("cashier_id")
  tableId         Int?          @map("table_id")
  orderType       OrderType     @default(DINE_IN) @map("order_type")
  customerName    String?       @map("customer_name") @db.VarChar(100)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus     OrderStatus   @default(WAITING_PAYMENT) @map("order_status")
  amountPaid      Decimal?      @map("amount_paid") @db.Decimal(12, 2)
  changeAmount    Decimal?      @map("change_amount") @db.Decimal(12, 2)
  snapToken       String?       @map("snap_token") @db.VarChar(255)
  midtransPayload Json?         @map("midtrans_payload")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer User?             @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: SetNull)
  cashier  User?             @relation("CashierTransactions", fields: [cashierId], references: [id], onDelete: SetNull)
  table    CafeTable?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items    TransactionItem[]

  @@index([customerId])
  @@index([cashierId])
  @@index([tableId])
  @@index([paymentStatus, orderStatus])
  @@map("transactions")
}

model TransactionItem {
  id            Int     @id @default(autoincrement())
  transactionId Int     @map("transaction_id")
  productId     Int     @map("product_id")
  productName   String  @map("product_name") @db.VarChar(150)
  priceAtSale   Decimal @map("price_at_sale") @db.Decimal(12, 2)
  quantity      Int
  notes         String? @db.VarChar(255)
  subtotal      Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}